end


# ============================================================
# DEMONSTRATION
# ============================================================

function demo()

    amp =
        GuitarAmplifier()


    # Start with clean tone.

    apply_preset!(
        amp,
        CLEAN
    )


    apply_room!(
        amp,
        SMALL_ROOM
    )


    status(amp)


    # Generate a simple test guitar-like signal.

    duration =
        0.5


    n =
        Int(
            SAMPLE_RATE *
            duration
        )


    input =
        Vector{Float64}(
            undef,
            n
        )


    for i in 1:n

        t =
            (i - 1) /
            SAMPLE_RATE


        # Fundamental + harmonics.

        input[i] =

            0.60 *
            sin(
                PI2 *
                110.0 *
                t
            )

            +

            0.20 *
            sin(
                PI2 *
                220.0 *
                t
            )

            +

            0.10 *
            sin(
                PI2 *
                330.0 *
                t
            )

    end


    # Analyse guitar input.

    before =
        analyse(input)


    println(
        "INPUT RMS  : ",
        round(
            before.rms,
            digits=4
        )
    )


    println(
        "INPUT PEAK : ",
        round(
            before.peak,
            digits=4
        )
    )


    # Optimise gain.

    optimise_input_gain!(
        amp,
        input
    )


    # Process.

    output =
        process!(
            amp,
            input
        )


    after =
        analyse(output)


    println(
        "OUTPUT RMS : ",
        round(
            after.rms,
            digits=4
        )
    )


    println(
        "OUTPUT PEAK: ",
        round(
            after.peak,
            digits=4
        )
    )


    println()

    println(
        "Room analysis:"
    )


    println(
        room_scan(output)
    )


    output

end


