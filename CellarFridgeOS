module CellarFridgeOS

# ============================================================
# CELLARFRIDGE.OS
#
# Pure Julia
# Wine + Beer Refrigeration & Cellar Management
#
# FEATURES
#   • Dual temperature zones
#   • Wine temperature management
#   • Beer temperature management
#   • Humidity monitoring
#   • Compressor control
#   • Circulation fans
#   • Door monitoring
#   • Thermal hysteresis
#   • Energy optimisation
#   • Inventory tracking
#   • Temperature alarms
#   • Fault handling
#
# NOTE:
# A real appliance requires independent hardware thermal
# protection, compressor protection, electrical protection,
# sensor redundancy and certified refrigeration controls.
# ============================================================


const SOFTWARE = "CellarFridge.OS"
const VERSION = v"1.0.0"


# ============================================================
# STATES
# ============================================================

@enum ZoneState begin
    OFF
    COOLING
    HOLDING
    WARMING
    DOOR_OPEN
    FAULT
end


@enum BeverageType begin
    RED_WINE
    WHITE_WINE
    SPARKLING_WINE
    LAGER
    ALE
    STOUT
    IPA
    CIDER
end


