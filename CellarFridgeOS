    fridge::CellarFridge
)

    println()
    println("==========================================")
    println("          CELLARFRIDGE.OS")
    println("          VERSION ", VERSION)
    println("==========================================")

    println(
        "WINE STATE  : ",
        fridge.wine.state
    )

    println(
        "WINE TEMP   : ",
        round(
            fridge.sensors.wine_temperature_c,
            digits = 1
        ),
        " °C"
    )

    println(
        "WINE TARGET : ",
        fridge.wine.target_temperature_c,
        " °C"
    )

    println()

    println(
        "BEER STATE  : ",
        fridge.beer.state
    )

    println(
        "BEER TEMP   : ",
        round(
            fridge.sensors.beer_temperature_c,
            digits = 1
        ),
        " °C"
    )

    println(
        "BEER TARGET : ",
        fridge.beer.target_temperature_c,
        " °C"
    )

    println()

    println(
        "DOOR        : ",
        fridge.sensors.door_open ?
        "OPEN" :
        "CLOSED"
    )

    println(
        "INVENTORY   : ",
        total_units(
            fridge.inventory
        ),
        " units"
    )

    println(
        "WINE ENERGY : ",
        round(
            fridge.wine.energy_kwh,
            digits = 3
        ),
        " kWh"
    )

    println(
        "BEER ENERGY : ",
        round(
            fridge.beer.energy_kwh,
            digits = 3
        ),
        " kWh"
    )

    println("==========================================")

end


# ============================================================
# SELF TEST
# ============================================================

function self_test()

    fridge =
        CellarFridge()


    @assert set_profile!(
        fridge,
        :wine,
        WHITE_WINE
    ) ≈ 10.0


    @assert set_profile!(
        fridge,
        :beer,
        LAGER
    ) ≈ 5.0


    @assert start!(
        fridge
    )


    # Run thermal simulation.

    for _ in 1:1000

        update!(
            fridge,
            1.0
        )

    end


    @assert fridge.sensors.wine_temperature_c <
            20.0


    @assert fridge.sensors.beer_temperature_c <
            20.0


    # Inventory.

    stock!(
        fridge,
        "House Lager",
        LAGER,
        12
    )


    stock!(
        fridge,
        "Sauvignon Blanc",
        WHITE_WINE,
        6
    )


    @assert total_units(
        fridge.inventory
    ) == 18


    @assert consume!(
        fridge,
        "House Lager"
    )


    @assert total_units(
        fridge.inventory
    ) == 17


    println(
        "CellarFridge.OS SELF TEST: PASS"
    )

end


# ============================================================
# DEMO
# ============================================================

function demo()

    fridge =
        CellarFridge()


    # Wine zone.

    set_profile!(
        fridge,
        :wine,
        RED_WINE
    )


    # Beer zone.

    set_profile!(
        fridge,
        :beer,
        IPA
    )


    # Stock cellar.

    stock!(
        fridge,
        "Bordeaux",
        RED_WINE,
        6
    )


    stock!(
        fridge,
        "IPA",
        IPA,
        12
    )


    stock!(
        fridge,
        "Champagne",
        SPARKLING_WINE,
        3
    )


    start!(
        fridge
    )


    # Simulate 30 minutes.

    for _ in 1:1800

        update!(
            fridge,
            1.0
        )

    end


    status(
        fridge
    )

end


