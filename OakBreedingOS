function summary(
    program::BreedingProgram
)

    println()
    println("========================================")
    println(" OAK BREEDING OS")
    println("========================================")

    println(
        "PROGRAM      : ",
        program.name
    )

    println(
        "TREES        : ",
        length(program.trees)
    )

    println(
        "TRIALS       : ",
        length(program.trials)
    )

    println(
        "OBSERVATIONS : ",
        length(program.phenotypes)
    )

    println("========================================")

end


# ============================================================
# 20. EXPORT DATA
# ============================================================

function tree_report(
    program::BreedingProgram
)

    rows = NamedTuple[]


    for tree in values(program.trees)

        observations =
            phenotypes_for_tree(
                program,
                tree.id
            )


        isempty(observations) &&
            continue


        push!(
            rows,

            (
                id = tree.id,

                accession =
                    tree.accession,

                species =
                    tree.species,

                generation =
                    tree.pedigree.generation,

                breeding_value =
                    breeding_value(
                        program,
                        tree.id
                    ),

                observations =
                    length(observations)
            )
        )

    end


    rows

end


