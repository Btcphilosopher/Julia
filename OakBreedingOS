# 21. EXAMPLE PROGRAM
# ============================================================

function demo()

    Random.seed!(42)


    program =
        BreedingProgram(
            "Oak Resilience Research Programme"
        )


    # --------------------------------------------------------
    # Founding population
    # --------------------------------------------------------

    founders = Int[]


    for i in 1:30

        id =
            register_tree!(
                program;

                accession =
                    "FOUND-$i",

                species =
                    "Quercus robur",

                sex =
                    rand(
                        (FEMALE, MALE)
                    ),

                genotype =
                    random_genotype(32),

                generation = 0,

                birth_year = 2026
            )


        push!(
            founders,
            id
        )

    end


    # --------------------------------------------------------
    # Common field trial
    # --------------------------------------------------------

    create_trial!(
        program,

        "FOUNDERS-FIELD-2026",

        FIELD,

        founders;

        year = 2026
    )


    # --------------------------------------------------------
    # Drought research trial
    # --------------------------------------------------------

    create_trial!(
        program,

        "FOUNDERS-DROUGHT-2026",

        DROUGHT,

        founders;

        year = 2026
    )


    # --------------------------------------------------------
    # Selection index
    # --------------------------------------------------------

    index =
        SelectionIndex(

            1.0,    # height

            1.5,    # diameter

            2.0,    # health

            2.5,    # drought

            2.0,    # winter hardiness

            0.5     # acorn production
        )


    # --------------------------------------------------------
    # Select elite candidates
    # --------------------------------------------------------

    parents =
        select_parents(
            program,
            8;

            index
        )


    println()
    println("SELECTED PARENTS")
    println("----------------")

    for id in parents

        println(
            "Tree ",
            id,
            " | ",
            program.trees[id].accession,
            " | BV = ",
            round(
                breeding_value(
                    program,
                    id
                ),
                digits = 3
            )
        )

    end


    # --------------------------------------------------------
    # Crossing plan
    # --------------------------------------------------------

    plans =
        generate_cross_plan(
            parents
        )


    println()
    println(
        "CROSS PLANS: ",
        length(plans)
    )


    # --------------------------------------------------------
    # Generate next generation
    # --------------------------------------------------------

    generation_1 =
        generate_offspring!(
            program,

            plans,

            5,

            1
        )


    println(
        "GENERATION 1 OFFSPRING: ",
        length(generation_1)
    )


    # --------------------------------------------------------
    # Test generation 1
    # --------------------------------------------------------

    create_trial!(
        program,

        "G1-FIELD",

        FIELD,

        generation_1;

        year = 2030
    )


    create_trial!(
        program,

        "G1-DROUGHT",

        DROUGHT,

        generation_1;

        year = 2030
    )


    # --------------------------------------------------------
    # Summary
    # --------------------------------------------------------

    summary(program)


    return program

end


