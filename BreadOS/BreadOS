# ============================================================
# DOUGH MODEL
# ============================================================

mutable struct Dough

    mass_g::Float64

    hydration::Float64

    temperature_c::Float64

    gluten_development::Float64

    fermentation::Float64

    proof::Float64

    elasticity::Float64

    stickiness::Float64

    volume_ratio::Float64

end


function Dough(
    ingredients::Ingredients,
    temperature_c::Float64
)

    flour =
        ingredients.flour_g


    water =
        ingredients.water_g


    total =
        ingredients.flour_g +
        ingredients.water_g +
        ingredients.yeast_g +
        ingredients.salt_g +
        ingredients.sugar_g +
        ingredients.fat_g +
        ingredients.milk_powder_g


    Dough(

        total,

        water / flour,

        temperature_c,

        0.0,

        0.0,

        0.0,

        0.15,

        0.50,

        1.0

    )

end


# ============================================================
# HEATER
