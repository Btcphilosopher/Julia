mutable struct Heater

    enabled::Bool

    power_percent::Float64

    maximum_power_percent::Float64

end


Heater() =
    Heater(

        false,

        0.0,

        100.0

    )


function set_power!(

    heater::Heater,

    power::Real

)

    heater.power_percent =
        clamp(

            Float64(power),

            0.0,

            heater.maximum_power_percent

        )

    heater.enabled =
        heater.power_percent > 0

end


function stop!(
    heater::Heater
)

    heater.enabled =
        false

    heater.power_percent =
        0.0

end


