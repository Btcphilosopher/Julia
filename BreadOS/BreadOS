# ============================================================

struct TelemetryPoint

    timestamp::DateTime

    state::BreadState

    dough_phase::DoughPhase

    chamber_temperature_c::Float64

    dough_temperature_c::Float64

    motor_rpm::Float64

    motor_current_a::Float64

    gluten_development::Float64

    fermentation::Float64

    proof::Float64

    dough_volume_ratio::Float64

end


mutable struct Telemetry

    points::Vector{TelemetryPoint}

end


Telemetry() =
    Telemetry(
        TelemetryPoint[]
    )


function record!(

    telemetry::Telemetry,

    machine

)

    dough =
        machine.dough


    dough === nothing &&
        return


    push!(

        telemetry.points,

        TelemetryPoint(

            now(),

            machine.state,

            machine.dough_phase,

            machine.temperature.temperature_c,

            dough.temperature_c,

            machine.motor.rpm,

            machine.motor.current_a,

            dough.gluten_development,

            dough.fermentation,

            dough.proof,

            dough.volume_ratio

        )

    )

end


