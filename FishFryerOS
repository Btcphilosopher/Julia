module FishFryerOS

using Dates

# ============================================================
# FISHFRYER.OS
#
# Production-Grade Commercial Fish & Chip Fryer Controller
#
# Pure Julia
#
# PURPOSE
# -------
# Supervisory control software for a commercial fryer capable
# of continuous fish-and-chip production.
#
# CORE SYSTEMS
# ------------
#   1. Fryer state machine
#   2. Recipe engine
#   3. Multi-vat management
#   4. Thermal control
#   5. Basket sequencing
#   6. Oil monitoring
#   7. Production tracking
#   8. HACCP-oriented records
#   9. Alarm management
#  10. Diagnostics
#  11. Cleaning/service modes
#
# IMPORTANT
# ---------
# This software is NOT the sole safety mechanism.
#
# Commercial hardware must independently implement:
#
#   - emergency stop
#   - independent over-temperature protection
#   - burner/heater safety
#   - flame supervision where applicable
#   - pressure protection
#   - oil-level protection
#   - electrical isolation
#   - mechanical guarding
#   - safety-rated interlocks
#
# ============================================================


# ============================================================
# ENUMERATIONS
# ============================================================

@enum FryerState begin
    POWER_OFF
    INITIALISING
    PREHEATING
    READY
    LOADING
    COOKING
    DRAINING
    HOLDING
    CLEANING
    SERVICE
    SHUTDOWN
    FAULT
end


@enum CookStage begin
    NO_STAGE
    FIRST_FRY
    SECOND_FRY
    FISH_FRY
end


@enum BasketState begin
    BASKET_UNKNOWN
    BASKET_UP
    BASKET_DOWN
    BASKET_MOVING
end


@enum AlarmSeverity begin
    INFO
    WARNING
    CRITICAL
end


# ============================================================
# PRODUCT RECIPE
# ============================================================

struct FryRecipe

    name::Symbol

    product::Symbol

    stage::CookStage

    target_temperature_c::Float64

    cook_time_s::Float64

    drain_time_s::Float64

    maximum_batch_mass_kg::Float64

    minimum_temperature_c::Float64

end


