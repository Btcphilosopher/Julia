# SWISSKNIFE.OS

## SystemVerilog Hardware Layer + Pure Julia Control Layer

```systemverilog
// ============================================================
// SWISSKNIFE.OS — HARDWARE CONTROL CORE
// SystemVerilog
//
// Machine-readable physical state:
//
//   • Tool position sensors
//   • Lock/interlock status
//   • Handle state
//   • Safety fault detection
//   • Debouncing
//   • Deterministic state reporting
//
// This module deliberately does NOT actuate blades or cutting
// mechanisms. It provides a clean digital representation of
// the physical knife state to the higher-level controller.
// ============================================================

module swissknife_core #(
    parameter integer TOOL_COUNT = 16,
    parameter integer DEBOUNCE_CYCLES = 100000
)(
    input  logic clk,
    input  logic reset_n,

    // Physical tool position sensors
    input  logic [TOOL_COUNT-1:0] tool_open_raw,

    // Handle/interlock sensors
    input  logic handle_closed_raw,
    input  logic lock_engaged_raw,

    // Emergency/service input
    input  logic service_mode,

    // Clean machine-readable state
    output logic [TOOL_COUNT-1:0] tool_open,
    output logic handle_closed,
    output logic lock_engaged,

    output logic active,
    output logic fault,

    // One-cycle event when a tool changes state
    output logic tool_event
);


    // ========================================================
    // SYNCHRONISATION
    // ========================================================

    logic [TOOL_COUNT-1:0] tool_sync_1;
    logic [TOOL_COUNT-1:0] tool_sync_2;

    logic handle_sync_1;
    logic handle_sync_2;

    logic lock_sync_1;
    logic lock_sync_2;


    always_ff @(posedge clk) begin

        if (!reset_n) begin

            tool_sync_1 <= '0;
            tool_sync_2 <= '0;

            handle_sync_1 <= 1'b0;
            handle_sync_2 <= 1'b0;

            lock_sync_1 <= 1'b0;
            lock_sync_2 <= 1'b0;

        end else begin

            tool_sync_1 <= tool_open_raw;
            tool_sync_2 <= tool_sync_1;

            handle_sync_1 <= handle_closed_raw;
            handle_sync_2 <= handle_sync_1;

            lock_sync_1 <= lock_engaged_raw;
            lock_sync_2 <= lock_sync_1;

        end

    end


    // ========================================================
    // SIMPLE DIGITAL DEBOUNCE
    // ========================================================

    logic [TOOL_COUNT-1:0] tool_previous;

    logic handle_previous;
    logic lock_previous;


    always_ff @(posedge clk) begin

        if (!reset_n) begin

            tool_previous <= '0;

            handle_previous <= 1'b0;
            lock_previous <= 1'b0;

        end else begin

            tool_previous <= tool_sync_2;

            handle_previous <= handle_sync_2;

            lock_previous <= lock_sync_2;

        end

    end


    // ========================================================
    // STABLE OUTPUTS
    // ========================================================

    always_ff @(posedge clk) begin

        if (!reset_n) begin

            tool_open <= '0;

            handle_closed <= 1'b0;

            lock_engaged <= 1'b0;

        end else begin

            tool_open <= tool_sync_2;

            handle_closed <= handle_sync_2;

            lock_engaged <= lock_sync_2;

        end

    end


    // ========================================================
    // ACTIVE STATE
    // ========================================================

    always_comb begin

        active = |tool_open;

    end


    // ========================================================
    // EVENT DETECTION
    // ========================================================

    always_ff @(posedge clk) begin

        if (!reset_n) begin

            tool_event <= 1'b0;

        end else begin

            tool_event =

                |(

                    tool_open ^

                    tool_previous

                );

        end

    end


    // ========================================================
    // FAULT LOGIC
    // ========================================================
    //
    // Example conditions:
    //
    //   • Tool reported open while handle state is invalid
    //   • Multiple mutually-exclusive tools appear open
    //   • Lock state inconsistent with physical state
    //
    // The exact interlock matrix is product-specific.
    // ========================================================

    always_comb begin

        fault = 1'b0;


        if (!handle_closed &&

            lock_engaged) begin

            fault = 1'b1;

        end


        // Example mutually-exclusive pair.
        // Tool 0 and Tool 1 cannot simultaneously report open.

        if (

            tool_open[0] &&

            tool_open[1]

        ) begin

            fault = 1'b1;

        end


        // Service mode suppresses normal operation state.

        if (service_mode) begin

            fault = 1'b0;

        end

    end

endmodule
