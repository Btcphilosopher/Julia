# ============================================================
# BEAT POSITION
# ============================================================

function current_beat(
    deck::Deck
)

    deck.track === nothing &&
        return 0

    bpm =
        deck.tempo.bpm

    deck.position.seconds *
        bpm / 60.0

end


# ============================================================
# ADVANCE DECK
# ============================================================

function advance!(
    deck::Deck,
    dt::Real
)

    deck.state != DECK_PLAYING &&
        return

    track =
        deck.track

    track === nothing &&
        return

    ratio =
        deck.tempo.bpm /
        track.bpm

    delta =
        Float64(dt) * ratio

    if deck.direction == FORWARD

        newpos =
            deck.position.seconds +
            delta

    else

        newpos =
            deck.position.seconds -
            delta

    end

    if deck.loop.state == LOOP_ACTIVE

        if newpos >= deck.loop.end_s

            newpos =
                deck.loop.start_s

        end

    end

    if newpos >= track.duration_s

        newpos =
            0.0

        deck.state =
            DECK_CUED

    elseif newpos < 0

        newpos =
            0.0

        deck.state =
            DECK_CUED

    end

    deck.position.seconds =
        newpos

end


# ============================================================
# SEEK
# ============================================================

function seek!(
    deck::Deck,
    seconds::Real
)

    deck.track === nothing &&
        return false

    deck.position.seconds =
        clamp(
            Float64(seconds),
            0.0,
            deck.track.duration_s
        )

    true

end


# ============================================================
# SCRATCH
# ============================================================

function scratch!(
    deck::Deck,
    delta::Real
)

    deck.jog.touch ||
        return false

    seek!(
        deck,
        deck.position.seconds -
        Float64(delta) * 0.02
    )

    true

end


