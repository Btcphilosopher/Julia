        controller.deck_a,
        house
    )

    load_track!(
        controller.deck_b,
        techno
    )


    # --------------------------------------------------------
    # PREPARE DECKS
    # --------------------------------------------------------

    set_pitch!(
        controller.deck_a,
        0.0
    )

    set_pitch!(
        controller.deck_b,
        -3.03
    )


    sync!(
        controller.deck_a,
        controller.deck_b
    )


    # --------------------------------------------------------
    # HOT CUE
    # --------------------------------------------------------

    set_cue!(
        controller.deck_a.cues,
        1,
        0.0
    )


