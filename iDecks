# ============================================================
# LOOP ENGINE
# ============================================================

mutable struct LoopEngine

    state::LoopState

    start_s::Float64
    end_s::Float64

    beats::Int

end


function LoopEngine()

    LoopEngine(
        LOOP_OFF,
        0.0,
        0.0,
        0
    )

end


function set_loop!(
    loop::LoopEngine,
    current_s::Real,
    beats::Int,
    bpm::Real
)

    interval =
        60.0 / Float64(bpm)

    length_s =
        interval * beats

    loop.start_s =
        Float64(current_s)

    loop.end_s =
        Float64(current_s) +
        length_s

    loop.beats = beats

    loop.state =
        LOOP_ARMED

end


function activate_loop!(
    loop::LoopEngine
)

    if loop.end_s > loop.start_s

        loop.state =
            LOOP_ACTIVE

    end

end


function disable_loop!(
    loop::LoopEngine
)

    loop.state =
        LOOP_OFF

end


function loop_position!(
    loop::LoopEngine,
    position::Float64
)

    if loop.state == LOOP_ACTIVE

        if position >= loop.end_s

            return loop.start_s

        end

    end

    position

end


