    touch::Bool

    sensitivity::Float64

    pitch_bend::Float64

end


function JogWheel()

    JogWheel(
        0.0,
        0.0,
        false,
        1.0,
        0.0
    )

end


function rotate!(
    jog::JogWheel,
    delta::Real
)

    jog.velocity =
        Float64(delta) *
        jog.sensitivity

    jog.position +=
        jog.velocity

    jog.pitch_bend =
        clamp(
            jog.velocity * 0.02,
            -1.0,
            1.0
        )

end


function touch!(
    jog::JogWheel,
    active::Bool
)

    jog.touch = active

end


