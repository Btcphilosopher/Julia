    library::TrackLibrary,
    query::AbstractString
)

    q =
        lowercase(query)

    [
        track
        for track in library.tracks
        if occursin(
            q,
            lowercase(track.title)
        ) ||
        occursin(
            q,
            lowercase(track.artist)
