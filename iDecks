# ============================================================
# TESTS
# ============================================================

function self_test()

    controller =
        iDecksController()


    # Track loading

    track =
        generate_test_track(
            "Test";
            bpm=120.0,
            duration_s=10.0
        )

    load_track!(
        controller.deck_a,
        track
    )

    @assert controller.deck_a.track !== nothing

    @assert controller.deck_a.state ==
            DECK_CUED


    # Playback

    play!(
        controller.deck_a
    )

    @assert controller.deck_a.state ==
            DECK_PLAYING


    update!(
        controller,
        0.5
    )


    @assert controller.deck_a.position.seconds >
            0.0


    # Crossfader

    set_crossfader!(
        controller.mixer.crossfader,
        0.0
    )

    a,b =
        mix_gains(
            controller.mixer
        )

    @assert a > b


    set_crossfader!(
        controller.mixer.crossfader,
        1.0
    )

    a,b =
        mix_gains(
            controller.mixer
        )

    @assert b > a


    # Cue

    set_cue!(
        controller.deck_a.cues,
        1,
        2.0
    )

    cue_position =
        jump_to_cue!(
            controller.deck_a.cues,
            1
        )

    @assert cue_position == 2.0


    # Loop

    quantised_loop!(
        controller.deck_a,
        4
    )

    @assert controller.deck_a.loop.state ==
            LOOP_ACTIVE


    # Safety of stopped engine

    stop!(
        controller

    )

    @assert !controller.running


    true

end


