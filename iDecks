# ============================================================
# EVENT DISPATCH
# ============================================================

function handle!(
    controller::iDecksController,
    event::ButtonEvent
)

    if event.id == :PLAY_A &&
       event.pressed

        play!(
            controller.deck_a
        )

    elseif event.id == :PLAY_B &&
           event.pressed

        play!(
            controller.deck_b
        )

    elseif event.id == :CUE_A &&
           event.pressed

        cue!(
            controller.deck_a
        )

    elseif event.id == :CUE_B &&
           event.pressed

        cue!(
            controller.deck_b
        )

    elseif event.id == :SYNC &&
           event.pressed

        beat_sync!(
            controller
        )

    end

end


function handle!(
    controller::iDecksController,
    event::FaderEvent
)

    if event.id == :CROSSFADER

        set_crossfader!(
            controller.mixer.crossfader,
            event.value
        )

    elseif event.id == :TEMPO_A

        set_pitch!(
            controller.deck_a,
            event.value
        )

    elseif event.id == :TEMPO_B

        set_pitch!(
            controller.deck_b,
            event.value
        )

    end

end


function handle!(
    controller::iDecksController,
    event::EncoderEvent
)

    if event.id == :JOG_A

        rotate!(
            controller.deck_a.jog,
            event.delta
        )

        scratch!(
            controller.deck_a,
            event.delta
        )

    elseif event.id == :JOG_B

        rotate!(
            controller.deck_b.jog,
            event.delta
        )

        scratch!(
            controller.deck_b,
            event.delta
        )

    end

end


# ============================================================
# STATUS
# ============================================================

function deck_status(
    deck::Deck
)

    (
        id = deck.id,
        state = deck.state,
        track =
            deck.track === nothing ?
            "EMPTY" :
            deck.track.title,
        position =
            deck.position.seconds,
        bpm =
            deck.tempo.bpm,
        pitch =
            deck.tempo.pitch_percent,
        loop =
            deck.loop.state
    )

end


function status(
    controller::iDecksController
)

    (
        version = IDECKS_VERSION,

        running =
            controller.running,

        deck_a =
            deck_status(
                controller.deck_a
            ),

        deck_b =
            deck_status(
                controller.deck_b
            ),

        crossfader =
            controller.mixer
                .crossfader
                .position,

        master_bpm =
            controller.clock.bpm
    )

end


# ============================================================
# AUTOMATION ENGINE
# ============================================================

mutable struct AutomationStep

    time_s::Float64

    action::Function

end


mutable struct AutomationEngine

    steps::Vector{AutomationStep}

    index::Int

end


function AutomationEngine()

    AutomationEngine(
        AutomationStep[],
        1
    )

end


function add_step!(
    automation::AutomationEngine,
    time_s::Real,
    action::Function
)

    push!(
        automation.steps,
        AutomationStep(
            Float64(time_s),
            action
        )
    )

end


function update!(
    automation::AutomationEngine,
    controller::iDecksController,
    time_s::Real
)

    while automation.index <=
          length(automation.steps)

        step =
            automation.steps[
                automation.index
            ]

        if time_s >= step.time_s

            step.action(
                controller
            )

            automation.index += 1

        else

            break

        end

    end

end


# ============================================================
# DIAGNOSTICS
# ============================================================

function diagnostics(
    controller::iDecksController
)

    warnings =
        String[]

    for deck in (
        controller.deck_a,
        controller.deck_b
    )

        if deck.track === nothing

            push!(
                warnings,
                "Deck $(deck.id) has no track"
            )

        end

        if deck.tempo.bpm <= 0

            push!(
                warnings,
                "Deck $(deck.id) has invalid BPM"
            )

        end

    end

    warnings

end


