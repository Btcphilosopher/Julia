    stop!(controller.deck_b)

end


# ============================================================
# ENGINE UPDATE
# ============================================================

function update!(
    controller::iDecksController,
    dt::Real
)

    controller.running ||
        return

    advance!(
        controller.deck_a,
        dt
    )

    advance!(
        controller.deck_b,
        dt
    )

    update_clock!(
        controller.clock,
        dt
    )

end


# ============================================================
# BPM DETECTION
# ============================================================

function estimate_bpm(
    samples::AbstractVector,
    sample_rate::Int
)

    isempty(samples) &&
        return 0.0

    # Lightweight heuristic estimator.
    #
    # Production implementation can be replaced with
    # FFT/autocorrelation/onset detection.

    energy =
        mean(
            abs2,
            Float64.(samples)
        )

    energy <= 1e-12 &&
        return 0.0

    120.0

end


# ============================================================
# AUTOMATIC SYNC
# ============================================================

function beat_sync!(
    controller::iDecksController
)

    a =
        controller.deck_a

    b =
        controller.deck_b

    a.track === nothing &&
        return false

    b.track === nothing &&
        return false

    b.tempo.bpm =
        a.tempo.bpm

    beat_a =
        current_beat(a)

    beat_b =
        current_beat(b)

    difference =
        beat_a - beat_b

    b.position.seconds +=
        difference *
        60.0 /
        b.tempo.bpm

    true

end


# ============================================================
# LOOP QUANTISATION
# ============================================================

function quantised_loop!(
    deck::Deck,
    beats::Int
)

    deck.track === nothing &&
        return false

    beat =
        current_beat(deck)

    grid =
        round(beat)

    position =
        grid *
        60.0 /
        deck.tempo.bpm

    set_loop!(
        deck.loop,
        position,
        beats,
        deck.tempo.bpm
    )

    activate_loop!(
        deck.loop
    )

    true

end


