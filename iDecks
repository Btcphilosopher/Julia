# ============================================================
# READ DECK SAMPLE
# ============================================================

function deck_sample(
    deck::Deck
)

    track =
        deck.track

    track === nothing &&
        return (Sample(0),Sample(0))

    frame =
        clamp(
            Int(floor(
                deck.position.seconds *
                track.sample_rate
            )) + 1,
            1,
            length(track.samples) ÷ 2
        )

    (
        track.samples[2frame-1],
        track.samples[2frame]
    )

end


# ============================================================
# MASTER AUDIO MIX
# ============================================================

function render_frame!(
    mixer::MasterMixer,
    deck_a::Deck,
    deck_b::Deck
)

    a =
        deck_sample(deck_a)

    b =
        deck_sample(deck_b)

    gain_a,
    gain_b =
        mix_gains(mixer)

    left =
        (
            a[1] * gain_a +
            b[1] * gain_b
        ) *
        mixer.master_gain

    right =
        (
            a[2] * gain_a +
            b[2] * gain_b
        ) *
        mixer.master_gain

    (
        soft_limit(
            left,
            mixer.limiter_threshold
        ),
        soft_limit(
            right,
            mixer.limiter_threshold
        )
    )

end


