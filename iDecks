# ============================================================
# MIX GAIN
# ============================================================

function mix_gains(
    mixer::MasterMixer
)

    left,right =
        gains(
            mixer.crossfader
        )

    (
        mixer.deck_a_gain * left,
        mixer.deck_b_gain * right
    )

end


# ============================================================
# SIMPLE SOFT LIMITER
# ============================================================

function soft_limit(
    x::Real,
    threshold::Real = 0.95
)

    y =
        Float64(x)

    abs(y) <= threshold &&
        return Sample(y)

    sign(y) *
        Sample(
            threshold +
            (1.0 - threshold) *
            tanh(
                (abs(y)-threshold) /
                (1.0-threshold)
            )
        )

end


