# ============================================================
# DJ TRACK
# ============================================================

mutable struct Track

    title::String
    artist::String

    bpm::Float64
    duration_s::Float64

    sample_rate::Int
    channels::Int

    samples::Vector{Sample}

    beat_positions::Vector{Float64}

end


function Track(
    title::String,
    artist::String;
    bpm::Real = 120.0,
    duration_s::Real = 180.0,
    sample_rate::Int = 48_000
)

    n =
        Int(round(duration_s * sample_rate * 2))

    Track(
        title,
        artist,
        Float64(bpm),
        Float64(duration_s),
        sample_rate,
        2,
        zeros(Sample,n),
        Float64[]
    )

end


# ============================================================
# LOAD SYNTHETIC TRACK
#
# Useful for testing the engine without external audio I/O.
# ============================================================

function generate_test_track(
    title;
    bpm = 128.0,
    duration_s = 60.0,
    sample_rate = 48_000
)

    track =
        Track(
            title,
            "iDecks Test Artist";
            bpm=bpm,
            duration_s=duration_s,
            sample_rate=sample_rate
        )

    nframes =
        Int(round(duration_s * sample_rate))

    resize!(
        track.samples,
        nframes * 2
    )

    for i in 1:nframes

        t = (i - 1) / sample_rate

        beat =
            sin(2π * bpm / 60 * t)

        bass =
            0.25 *
            sin(2π * 55 * t)

        sample =
            Sample(
                0.15 * beat +
                bass
            )

        track.samples[2i-1] = sample
        track.samples[2i] = sample

    end

    generate_beatgrid!(track)

    track

end


# ============================================================
# BEAT GRID
# ============================================================

function generate_beatgrid!(
    track::Track
)

    empty!(
        track.beat_positions
    )

    interval =
        60.0 / track.bpm

    t = 0.0

    while t < track.duration_s

        push!(
            track.beat_positions,
            t
        )

        t += interval

    end

    track

end


