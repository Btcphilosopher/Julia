using Dates

# ============================================================
# 汽车数字钥匙与自动锁车系统
# Julia Prototype
# ============================================================

# ------------------------------------------------------------
# 1. 车辆状态
# ------------------------------------------------------------

mutable struct 车辆状态
    发动机运行::Bool
    车辆已锁::Bool
    车门关闭::Bool
    后备箱关闭::Bool
    驻车::Bool
    车辆速度::Float64
end


# ------------------------------------------------------------
# 2. 数字钥匙状态
# ------------------------------------------------------------

mutable struct 数字钥匙
    已认证::Bool
    距离车辆::Float64
    信号强度::Float64
    最后检测时间::DateTime
end


# ------------------------------------------------------------
# 3. 自动锁车配置
# ------------------------------------------------------------

struct 自动锁车配置
    启用::Bool
    离车距离::Float64
    确认时间::Int
    最低信号强度::Float64
end


# ------------------------------------------------------------
# 4. 系统状态
# ------------------------------------------------------------

mutable struct 汽车钥匙系统
    车辆::车辆状态
    钥匙::数字钥匙
    配置::自动锁车配置

    离车开始时间::Union{Nothing,DateTime}

    上一次锁车时间::Union{Nothing,DateTime}

    系统状态::String
end


# ------------------------------------------------------------
# 5. 创建系统
# ------------------------------------------------------------

function 创建系统()

    车辆 = 车辆状态(
        false,   # 发动机
        false,   # 已锁
        true,    # 车门
        true,    # 后备箱
        true,    # 驻车
        0.0
    )

    钥匙 = 数字钥匙(
        true,
        0.0,
        -40.0,
        now()
    )

    配置 = 自动锁车配置(
        true,
        3.0,     # 3米
        5,       # 连续5秒
        -70.0
    )

    return 汽车钥匙系统(
        车辆,
        钥匙,
        配置,
        nothing,
        nothing,
        "正常"
    )
end


# ------------------------------------------------------------
# 6. 更新钥匙位置
# ------------------------------------------------------------

function 更新钥匙状态!(
    系统::汽车钥匙系统,
    距离::Float64,
    信号强度::Float64
)

    系统.钥匙.距离车辆 = max(0.0, 距离)

    系统.钥匙.信号强度 = 信号强度

    系统.钥匙.最后检测时间 = now()

end


# ------------------------------------------------------------
# 7. 更新车辆状态
# ------------------------------------------------------------

function 更新车辆状态!(
    系统::汽车钥匙系统;
    发动机运行=nothing,
    车辆已锁=nothing,
    车门关闭=nothing,
    后备箱关闭=nothing,
    驻车=nothing,
    车辆速度=nothing
)

    if 发动机运行 !== nothing
        系统.车辆.发动机运行 = 发动机运行
    end

    if 车辆已锁 !== nothing
        系统.车辆.车辆已锁 = 车辆已锁
    end

    if 车门关闭 !== nothing
        系统.车辆.车门关闭 = 车门关闭
    end

    if 后备箱关闭 !== nothing
        系统.车辆.后备箱关闭 = 后备箱关闭
    end

    if 驻车 !== nothing
        系统.车辆.驻车 = 驻车
    end

    if 车辆速度 !== nothing
        系统.车辆.车辆速度 = 车辆速度
    end

end


# ------------------------------------------------------------
# 8. 判断是否满足自动锁车条件
# ------------------------------------------------------------

function 可以自动锁车(
    系统::汽车钥匙系统
)

    车辆 = 系统.车辆
    钥匙 = 系统.钥匙
    配置 = 系统.配置

    # 自动锁车功能关闭
    if !配置.启用
        return false
    end

    # 数字钥匙必须经过认证
    if !钥匙.已认证
        return false
    end

    # 已经锁车
    if 车辆.车辆已锁
        return false
    end

    # 发动机仍然运行
    if 车辆.发动机运行
        return false
    end

    # 车辆没有驻车
    if !车辆.驻车
        return false
    end

    # 车辆仍在移动
    if 车辆.速度 > 0.5
        return false
    end

    # 有车门未关闭
    if !车辆.车门关闭
        return false
    end

    # 后备箱未关闭
    if !车辆.后备箱关闭
        return false
    end

    # 钥匙仍在车辆附近
    if 钥匙.距离车辆 <= 配置.离车距离
        return false
    end

    # 信号质量过低，不进行判断
    if 钥匙.信号强度 < 配置.最低信号强度
        return false
    end

    return true
end


# ------------------------------------------------------------
# 9. 自动锁车状态机
# ------------------------------------------------------------

function 自动锁车控制!(
    系统::汽车钥匙系统
)

    当前时间 = now()

    # ----------------------------------------
    # 已经锁车
    # ----------------------------------------

    if 系统.车辆.车辆已锁

        系统.离车开始时间 = nothing
        系统.系统状态 = "车辆已锁"

        return false
    end


    # ----------------------------------------
    # 不满足条件
    # ----------------------------------------

    if !可以自动锁车(系统)

        系统.离车开始时间 = nothing

        系统.系统状态 = "等待锁车条件"

        return false
    end


    # ----------------------------------------
    # 开始确认钥匙已经离车
    # ----------------------------------------

    if 系统.离车开始时间 === nothing

        系统.离车开始时间 = 当前时间

        系统.系统状态 = "确认钥匙离车"

        return false
    end


    # ----------------------------------------
    # 计算离车持续时间
    # ----------------------------------------

    持续时间 = Dates.value(
        当前时间 - 系统.离车开始时间
    ) / 1000


    # ----------------------------------------
    # 防止瞬间信号波动导致误锁
    # ----------------------------------------

    if 持续时间 < 系统.配置.确认时间

        系统.系统状态 =
            "等待确认 $(round(系统.配置.确认时间 - 持续时间, digits=1)) 秒"

        return false
    end


    # ----------------------------------------
    # 最终安全检查
    # ----------------------------------------

    if 可以自动锁车(系统)

        执行锁车!(
            系统

        )

        return true
    end

    return false
end


# ------------------------------------------------------------
# 10. 执行锁车
# ------------------------------------------------------------

function 执行锁车!(
    系统::汽车钥匙系统
)

    # ========================================================
    # 这里是车辆硬件接口的位置
    #
    # 实车中应由经过认证的 BCM / OEM API 执行：
    #
    # BCM.lock_all_doors()
    #
    # 而不是由 Julia 直接驱动车门执行器。
    # ========================================================

    系统.车辆.车辆已锁 = true

    系统.上一次锁车时间 = now()

    系统.离车开始时间 = nothing

    系统.系统状态 = "自动锁车完成"

    println(
        "[汽车钥匙系统] ",
        "车辆已自动锁车"
    )

end


# ------------------------------------------------------------
# 11. 紧急取消自动锁车
# ------------------------------------------------------------

function 取消自动锁车!(
    系统::汽车钥匙系统
)

    系统.离车开始时间 = nothing

    系统.系统状态 = "自动锁车已取消"

end


# ------------------------------------------------------------
# 12. 手动解锁
# ------------------------------------------------------------

function 解锁!(
    系统::汽车钥匙系统
)

    系统.车辆.车辆已锁 = false

    系统.离车开始时间 = nothing

    系统.系统状态 = "车辆已解锁"

end


# ------------------------------------------------------------
# 13. 实时系统循环
# ------------------------------------------------------------

function 运行汽车钥匙系统!(
    系统::汽车钥匙系统;
    周期::Float64 = 0.25
)

    println("================================")
    println("汽车数字钥匙系统启动")
    println("自动锁车：$(系统.配置.启用)")
    println("================================")

    while true

        自动锁车控制!(系统)

        sleep(周期)

    end

end


# ============================================================
# 14. 测试
# ============================================================

系统 = 创建系统()

# 模拟车辆已经停好
更新车辆状态!(
    系统,
    发动机运行=false,
    车门关闭=true,
    后备箱关闭=true,
    驻车=true,
    车辆速度=0.0
)

# 模拟车主拿着数字钥匙离开
更新钥匙状态!(
    系统,
    5.0,
    -50.0
)

# 手动执行控制循环
for i in 1:30

    自动锁车控制!(系统)

    println(
        "系统状态：",
        系统.系统状态
    )

    sleep(0.25)

end

