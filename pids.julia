using Dates
using Statistics

# ============================================================
# 中国铁路车站信息显示优化系统
# Passenger Information Display System (PIDS)
# Julia
# ============================================================

# ------------------------------------------------------------
# 1. 列车数据结构
# ------------------------------------------------------------

mutable struct 列车
    车次::String
    终到站::String
    计划到达::DateTime
    计划出发::DateTime
    预计到达::DateTime
    预计出发::DateTime
    股道::String
    状态::String
    延误分钟::Int
    优先级::Int
end


# ------------------------------------------------------------
# 2. 创建列车
# ------------------------------------------------------------

function 创建列车(
    车次,
    终到站,
    计划到达,
    计划出发;
    股道="待定",
    状态="正点",
    优先级=5
)

    return 列车(
        车次,
        终到站,
        计划到达,
        计划出发,
        计划到达,
        计划出发,
        股道,
        状态,
        0,
        优先级
    )
end


# ------------------------------------------------------------
# 3. 更新列车延误
# ------------------------------------------------------------

function 更新延误!(列车对象::列车, 延误分钟::Int)

    列车对象.延误分钟 = max(0, 延误分钟)

    列车对象.预计到达 =
        列车对象.计划到达 + Minute(列车对象.延误分钟)

    列车对象.预计出发 =
        列车对象.计划出发 + Minute(列车对象.延误分钟)

    if 延误分钟 == 0
        列车对象.状态 = "正点"
    elseif 延误分钟 <= 5
        列车对象.状态 = "轻微延误"
    elseif 延误分钟 <= 30
        列车对象.状态 = "延误"
    else
        列车对象.状态 = "严重延误"
    end

    return 列车对象
end


# ------------------------------------------------------------
# 4. 判断列车是否已经发车
# ------------------------------------------------------------

function 是否已经发车(列车对象::列车, 当前时间::DateTime)

    return 当前时间 >= 列车对象.预计出发
end


# ------------------------------------------------------------
# 5. 判断列车是否即将到达
# ------------------------------------------------------------

function 即将到达(列车对象::列车, 当前时间::DateTime)

    剩余时间 = Dates.value(
        列车对象.预计到达 - 当前时间
    ) / 60000

    return 0 <= 剩余时间 <= 15
end


# ------------------------------------------------------------
# 6. 删除已经完成的列车
# ------------------------------------------------------------

function 清理历史列车!(
    列车列表::Vector{列车},
    当前时间::DateTime
)

    filter!(
        列车对象 ->
            列车对象.预计出发 > 当前时间 - Minute(2),
        列车列表
    )

    return 列车列表
end


# ------------------------------------------------------------
# 7. 计算列车显示优先级
# ------------------------------------------------------------

function 计算显示优先级(
    列车对象::列车,
    当前时间::DateTime
)

    距离出发 = Dates.value(
        列车对象.预计出发 - 当前时间
    ) / 60000

    # 越接近出发，优先级越高
    if 距离出发 <= 5
        时间优先级 = 100
    elseif 距离出发 <= 15
        时间优先级 = 80
    elseif 距离出发 <= 30
        时间优先级 = 60
    elseif 距离出发 <= 60
        时间优先级 = 40
    else
        时间优先级 = 20
    end

    # 延误列车提高显示优先级
    延误优先级 =
        min(50, 列车对象.延误分钟)

    return 时间优先级 +
           延误优先级 +
           列车对象.优先级
end


# ------------------------------------------------------------
# 8. 优化车次排序
# ------------------------------------------------------------

function 优化列车顺序!(
    列车列表::Vector{列车},
    当前时间::DateTime
)

    sort!(
        列车列表,
        by = x -> (
            -计算显示优先级(x, 当前时间),
            x.预计出发
        )
    )

    return 列车列表
end


# ------------------------------------------------------------
# 9. 生成显示时间
# ------------------------------------------------------------

function 格式化时间(时间::DateTime)

    return Dates.format(时间, "HH:MM")
end


# ------------------------------------------------------------
# 10. 生成车站显示信息
# ------------------------------------------------------------

function 生成显示信息(
    列车对象::列车,
    当前时间::DateTime
)

    出发时间 = 格式化时间(
        列车对象.预计出发
    )

    到达时间 = 格式化时间(
        列车对象.预计到达
    )

    if 列车对象.状态 == "正点"

        状态显示 = "正点"

    elseif 列车对象.状态 == "轻微延误"

        状态显示 = "晚点 $(列车对象.延误分钟) 分钟"

    elseif 列车对象.状态 == "延误"

        状态显示 = "晚点 $(列车对象.延误分钟) 分钟"

    else

        状态显示 = "严重晚点"

    end

    return (
        车次 = 列车对象.车次,
        终到站 = 列车对象.终到站,
        到达 = 到达时间,
        出发 = 出发时间,
        股道 = 列车对象.股道,
        状态 = 状态显示
    )
end


# ------------------------------------------------------------
# 11. 防止显示器频繁刷新
# ------------------------------------------------------------

mutable struct 显示缓存

    上一次数据::String
    最后更新时间::DateTime

end


function 创建显示缓存()

    return 显示缓存(
        "",
        DateTime(2000, 1, 1)
    )
end


# ------------------------------------------------------------
# 12. 生成稳定显示字符串
# ------------------------------------------------------------

function 生成显示字符串(
    列车列表::Vector{列车},
    当前时间::DateTime
)

    行 = String[]

    for 列车对象 in 列车列表

        信息 = 生成显示信息(
            列车对象,
            当前时间
        )

        push!(
            行,
            "$(信息.车次)|" *
            "$(信息.终到站)|" *
            "$(信息.到达)|" *
            "$(信息.出发)|" *
            "$(信息.股道)|" *
            "$(信息.状态)"
        )

    end

    return join(行, "\n")
end


# ------------------------------------------------------------
# 13. 判断是否真的需要刷新屏幕
# ------------------------------------------------------------

function 是否需要刷新(
    缓存::显示缓存,
    新数据::String,
    当前时间::DateTime
)

    # 数据没有变化，不刷新
    if 新数据 == 缓存.上一次数据
        return false
    end

    # 防止短时间内大量刷新
    if 当前时间 - 缓存.最后更新时间 < Millisecond(500)
        return false
    end

    return true
end


# ------------------------------------------------------------
# 14. 更新显示缓存
# ------------------------------------------------------------

function 更新缓存!(
    缓存::显示缓存,
    新数据::String,
    当前时间::DateTime
)

    缓存.上一次数据 = 新数据
    缓存.最后更新时间 = 当前时间

end


# ------------------------------------------------------------
# 15. 车站显示控制器
# ------------------------------------------------------------

mutable struct 车站显示系统

    车站名称::String
    列车列表::Vector{列车}
    缓存::显示缓存
    系统状态::String

end


function 创建车站系统(车站名称)

    return 车站显示系统(
        车站名称,
        列车[],
        创建显示缓存(),
        "正常"
    )
end


# ------------------------------------------------------------
# 16. 添加列车
# ------------------------------------------------------------

function 添加列车!(
    系统::车站显示系统,
    列车对象::列车
)

    push!(
        系统.列车列表,
        列车对象
    )

end


# ------------------------------------------------------------
# 17. 核心优化循环
# ------------------------------------------------------------

function 优化系统!(
    系统::车站显示系统,
    当前时间::DateTime
)

    # 第一步：清除已经完成的列车
    清理历史列车!(
        系统.列车列表,
        当前时间
    )

    # 第二步：重新计算显示优先级
    优化列车顺序!(
        系统.列车列表,
        当前时间
    )

    # 第三步：生成新的显示数据
    新数据 = 生成显示字符串(
        系统.列车列表,
        当前时间
    )

    # 第四步：判断是否需要刷新屏幕
    if 是否需要刷新(
        系统.缓存,
        新数据,
        当前时间
    )

        更新缓存!(
            系统.缓存,
            新数据,
            当前时间
        )

        return 新数据

    end

    return nothing
end


# ------------------------------------------------------------
# 18. 模拟实时运行
# ------------------------------------------------------------

function 启动车站显示系统!(
    系统::车站显示系统;
    刷新周期::Float64 = 1.0
)

    println("========================================")
    println("车站信息显示系统启动")
    println("车站：$(系统.车站名称)")
    println("========================================")

    while true

        当前时间 = now()

        显示数据 = 优化系统!(
            系统,
            当前时间
        )

        if 显示数据 !== nothing

            println()
            println("【$(系统.车站名称)】")
            println("----------------------------------------")

            for 行 in split(显示数据, "\n")
                println(行)
            end

            println("----------------------------------------")
            println(
                "系统时间：",
                Dates.format(
                    当前时间,
                    "yyyy-mm-dd HH:MM:SS"
                )
            )

        end

        sleep(刷新周期)

    end

end


# ============================================================
# 19. 示例
# ============================================================

系统 = 创建车站系统("北京南站")

添加列车!(
    系统,
    创建列车(
        "G1",
        "上海虹桥",
        DateTime(2026, 10, 8, 17, 30),
        DateTime(2026, 10, 8, 17, 35),
        股道="3",
        优先级=10
    )
)

添加列车!(
    系统,
    创建列车(
        "G25",
        "天津南",
        DateTime(2026, 10, 8, 17, 45),
        DateTime(2026, 10, 8, 17, 50),
        股道="7",
        优先级=8
    )
)

添加列车!(
    系统,
    创建列车(
        "D665",
        "济南西",
        DateTime(2026, 10, 8, 18, 10),
        DateTime(2026, 10, 8, 18, 15),
        股道="11",
        优先级=6
    )
)

# 模拟 G25 晚点 8 分钟
更新延误!(
    系统.列车列表[2],
    8
)

# 执行一次优化
当前时间 = now()

显示结果 = 优化系统!(
    系统,
    当前时间
)

if 显示结果 !== nothing
    println(显示结果)
end

