# ============================================================
# 32. RESEARCH REPORT
# ============================================================

function research_report(
    program::BreedingProgram,

    index::SelectionIndex
)

    ranking =
        rank_fish(
            program,
            index
        )


    println()
    println(
        "RHINOBANK BREEDING REPORT"
    )

    println(
        "-------------------------"
    )


    for (rank, entry)
        in enumerate(ranking)

        fish_id =
            entry[1]

        score =
            entry[2]


        fish =
            program.fish[
                fish_id
            ]


        println(

            lpad(
                rank,
                3
            ),

            " | FISH ",

            fish_id,

            " | ",

            fish.strain,

            " | G",

            fish.generation,

            " | SCORE ",

            round(
                score,
                digits = 3
            )
        )

    end

end


