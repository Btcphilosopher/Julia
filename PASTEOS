# ============================================================
# SAFETY
# ============================================================

mutable struct SafetySystem

    lid_closed::Bool

    vessel_locked::Bool

    grinder_guard_closed::Bool

    mixer_guard_closed::Bool

    motor_overload::Bool

    overtemperature::Bool

    emergency_stop::Bool

    maximum_temperature_c::Float64

end


function SafetySystem()

    SafetySystem(

        true,
        true,
        true,
        true,
        false,
        false,
        false,
        103.0

    )

end


function check_safety!(

    safety::SafetySystem,

    mixer::MixerSystem,

    grinder::GrinderSystem,

    thermal::ThermalSystem

)

    safety.motor_overload =

        mixer.overload


    safety.overtemperature =

        thermal.product_temperature_c >=
        safety.maximum_temperature_c


    if !safety.lid_closed ||
       !safety.vessel_locked ||
       !safety.grinder_guard_closed ||
       !safety.mixer_guard_closed ||
       safety.motor_overload ||
       safety.overtemperature ||
       safety.emergency_stop

        return false

    end


    true

end


