struct BatchRecord

    batch_id::String

    started_at::DateTime

    recipe_name::String

    initial_mass_g::Float64

end


function create_batch(

    recipe::PasteRecipe,

    mass_g::Float64

)

    BatchRecord(

        "PASTE-" *

        Dates.format(

            now(),

            "yyyymmdd-HHMMSS"

        ),

        now(),

        recipe.name,

        mass_g

    )

end


