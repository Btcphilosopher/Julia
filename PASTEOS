mutable struct ViscositySensor

    viscosity_index::Float64

    filtered_value::Float64

    sensor_noise::Float64

end


function ViscositySensor()

    ViscositySensor(

        0.0,

        0.0,

        0.01

    )

end


function read_viscosity!(

    sensor::ViscositySensor,

    product::PasteProduct

)

    sensor.viscosity_index =

        product.viscosity


    sensor.filtered_value =

        0.85 *
        sensor.filtered_value +

        0.15 *
        sensor.viscosity_index


    sensor.filtered_value

end


