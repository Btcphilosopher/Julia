# ============================================================
# CONSTRUCTOR
# ============================================================

function PasteMachine(

    name::String="PASTEOS-001",

    recipe::PasteRecipe=PasteRecipe()

)

    PasteMachine(

        name,

        IDLE,

        recipe,

        IngredientSystem(),

        PasteProduct(),

        ThermalSystem(),

        MixerSystem(),

        GrinderSystem(),

        ViscositySensor(),

        PHSensor(),

        SafetySystem(),

        Telemetry(),

        nothing,

        0.0,

        0.0

    )

end


# ============================================================
# START BATCH
# ============================================================

function start_batch!(

    machine::PasteMachine,

    raw_mass_g::Float64,

    water_mass_g::Float64

)

    machine.state == IDLE ||
        error(

            "PASTEOS must be idle."

        )


    load_ingredients!(

        machine.ingredients,

        raw_mass_g,

        water_mass_g,

        0.0,

        5.0,

        0.0

    )


    initialize_product!(

        machine.product,

        machine.ingredients

    )


    machine.batch =

        create_batch(

            machine.recipe,

            machine.product.mass_g

        )


    machine.state =
        DOSING


    machine.elapsed =
        0.0


    machine.state_elapsed =
        0.0

end


# ============================================================
# DOSING
# ============================================================

function dosing_step!(

    machine::PasteMachine,

    dt::Float64

)

    machine.state_elapsed += dt


    if machine.state_elapsed >= 5.0

        machine.state =
            CHOPPING

        machine.state_elapsed =
            0.0

    end

end


# ============================================================
# CHOPPING
# ============================================================

function chopping_step!(

    machine::PasteMachine,

    dt::Float64

)

    chop_product!(

        machine.product,

        machine.grinder,

        dt

    )


    machine.state_elapsed += dt


    if machine.state_elapsed >=

       machine.recipe.chopping_time_s

        machine.state =
            GRINDING

        machine.state_elapsed =
            0.0

    end

end


# ============================================================
# GRINDING
# ============================================================

function grinding_step!(

    machine::PasteMachine,

    dt::Float64

)

    grind_product!(

        machine.product,

        machine.grinder,

        dt

    )


    machine.state_elapsed += dt


    if machine.state_elapsed >=

       machine.recipe.grinding_time_s

        machine.state =
            MIXING

        machine.state_elapsed =
            0.0

    end

end


# ============================================================
# MIXING
# ============================================================

function mixing_step!(

    machine::PasteMachine,

    dt::Float64

)

    mix_product!(

        machine.product,

        machine.mixer,

        dt

    )


    machine.state_elapsed += dt


    if machine.state_elapsed >=

       machine.recipe.mixing_time_s

        machine.state =
            HEATING

        machine.state_elapsed =
            0.0

    end

end


# ============================================================
# HEATING
# ============================================================

function heating_step!(

    machine::PasteMachine,

    dt::Float64

)

    set_target_temperature!(

        machine.thermal,

        machine.recipe.target_temperature_c

    )


    update_thermal_system!(

        machine.thermal,

        dt,

        machine.product.mass_g

    )


    machine.product.temperature_c =

        machine.thermal.product_temperature_c


    machine.state_elapsed += dt


    if machine.product.temperature_c >=

       machine.recipe.target_temperature_c - 1.0

        machine.state =
            CONCENTRATING

        machine.state_elapsed =
            0.0

    end

end


# ============================================================
# CONCENTRATION
# ============================================================

function concentration_step!(

    machine::PasteMachine,

    dt::Float64

)

    set_target_temperature!(

        machine.thermal,

        machine.recipe.target_temperature_c

    )


    update_thermal_system!(

        machine.thermal,

        dt,

        machine.product.mass_g

    )


    machine.product.temperature_c =

        machine.thermal.product_temperature_c


    concentrate_product!(

        machine.product,

        machine.thermal,

        machine.mixer,

        dt

    )


    machine.state_elapsed += dt


    viscosity =

        read_viscosity!(

            machine.viscosity_sensor,

            machine.product

        )


    # Adaptive concentration:
    #
    # Don't simply stop because the timer expired.
    # Continue until the target rheological state is reached,
    # subject to a maximum process time.

    if viscosity >=

       machine.recipe.target_viscosity

        machine.state =
            VISCOSITY_CONTROL

        machine.state_elapsed =
            0.0

    elseif machine.state_elapsed >=

           machine.recipe.concentration_time_s

        machine.state =
            VISCOSITY_CONTROL

        machine.state_elapsed =
            0.0

    end

end


# ============================================================
# VISCOSITY CONTROL
# ============================================================

function viscosity_control_step!(

    machine::PasteMachine,

    dt::Float64

)

    viscosity =

        read_viscosity!(

            machine.viscosity_sensor,

            machine.product

        )


    error =

        machine.recipe.target_viscosity -
        viscosity


    if error > 0.03

        # Still too thin.

        set_mixer_speed!(

            machine.mixer,

            70.0

        )


        set_target_temperature!(

            machine.thermal,

            machine.recipe.target_temperature_c

        )


        update_thermal_system!(

            machine.thermal,

            dt,

            machine.product.mass_g

        )


        machine.product.temperature_c =

            machine.thermal.product_temperature_c


        concentrate_product!(

            machine.product,

            machine.thermal,

            machine.mixer,

            dt

        )

    else

        set_mixer_speed!(

            machine.mixer,

            25.0

        )


        machine.state_elapsed += dt

    end


    if abs(error) <= 0.03 ||

       machine.state_elapsed >= 60.0

        machine.state =
            FINISHING

        machine.state_elapsed =
            0.0

    end

end


# ============================================================
# FINISHING
# ============================================================

function finishing_step!(

    machine::PasteMachine,

    dt::Float64

)

    set_mixer_speed!(

        machine.mixer,

        20.0

    )


    update_mixer!(

        machine.mixer,

        machine.product.viscosity

    )


    machine.product.homogeneity +=

        0.001 *
        dt


    machine.product.homogeneity =

        clamp(

            machine.product.homogeneity,

            0.0,
            1.0

        )


    machine.state_elapsed += dt


    if machine.state_elapsed >=

       machine.recipe.finishing_time_s

        machine.state =
            COOLING

        machine.state_elapsed =
            0.0

    end

end


# ============================================================
# COOLING
# ============================================================

function cooling_step!(

    machine::PasteMachine,

    dt::Float64

)

    set_mixer_speed!(

        machine.mixer,

        15.0

    )


    machine.thermal.target_temperature_c =

        machine.thermal.ambient_temperature_c


    update_thermal_system!(

        machine.thermal,

        dt,

        machine.product.mass_g

    )


    machine.product.temperature_c =

        machine.thermal.product_temperature_c


    machine.state_elapsed += dt


    if machine.product.temperature_c <=

       machine.recipe.cooling_target_c

        machine.state =
            COMPLETE

        machine.state_elapsed =
            0.0

    end

end


# ============================================================
# EMERGENCY STOP
# ============================================================

function emergency_stop!(

    machine::PasteMachine

)

    set_mixer_speed!(
        machine.mixer,
        0.0
    )


    set_grinder_speed!(
        machine.grinder,
        0.0
    )


    machine.thermal.heater_enabled =
        false


    machine.thermal.heater_power_percent =
        0.0


    machine.safety.emergency_stop =
        true


    machine.state =
        EMERGENCY_STOP

end


# ============================================================
# MASTER CONTROL LOOP
# ============================================================

function control_step!(

    machine::PasteMachine,

    dt::Float64=1.0

)

    machine.state in (

        IDLE,
        COMPLETE,
        FAULT,
        EMERGENCY_STOP

    ) && return


    # ----------------------------------------
    # Safety interlock
    # ----------------------------------------

    if !check_safety!(

        machine.safety,

        machine.mixer,

        machine.grinder,

        machine.thermal

    )

        emergency_stop!(
            machine
        )

        return

    end


    # ----------------------------------------
    # State machine
    # ----------------------------------------

    if machine.state == DOSING

        dosing_step!(
            machine,
            dt
        )


    elseif machine.state == CHOPPING

        chopping_step!(
            machine,
            dt
        )


    elseif machine.state == GRINDING

        grinding_step!(
            machine,
            dt
        )


    elseif machine.state == MIXING

        mixing_step!(
            machine,
            dt
        )


    elseif machine.state == HEATING

        heating_step!(
            machine,
            dt
        )


    elseif machine.state == CONCENTRATING

        concentration_step!(
            machine,
            dt
        )


    elseif machine.state == VISCOSITY_CONTROL

        viscosity_control_step!(
            machine,
            dt
        )


    elseif machine.state == FINISHING

        finishing_step!(
            machine,
            dt
        )


    elseif machine.state == COOLING

        cooling_step!(
            machine,
            dt
        )

    end


    # ----------------------------------------
    # Sensors
    # ----------------------------------------

    read_pH!(

        machine.ph_sensor,

        machine.product

    )


    # ----------------------------------------
    # Telemetry
    # ----------------------------------------

    record_telemetry!(

        machine.telemetry,

        machine

    )


    machine.elapsed += dt

end


# ============================================================
# CLEANING SYSTEM
# ============================================================

function cleaning_cycle!(

    machine::PasteMachine

)

    machine.state in (

        IDLE,
        COMPLETE

    ) || error(

        "Cleaning can only begin when the process is stopped."

    )


    machine.state =
        CLEANING


    println(
        "PASTEOS CLEANING CYCLE"
    )


    println(
        "1. Drain product chamber"
    )


    println(
        "2. Flush product-contact surfaces"
    )


    println(
        "3. Wash mixing chamber"
    )


    println(
        "4. Clean grinding assembly"
    )


    println(
        "5. Rinse"
    )


    println(
        "6. Verify clean state"
    )


    machine.state =
        IDLE

end


# ============================================================
# QUALITY SCORE
# ============================================================

function quality_score(

    machine::PasteMachine

)

    viscosity_score =

        1.0 -

        min(

            abs(

                machine.product.viscosity -
                machine.recipe.target_viscosity

            ),

            1.0

        )


    particle_score =

        1.0 -

        min(

            machine.product.particle_size_mm /
            12.0,

            1.0

        )


    homogeneity_score =

        machine.product.homogeneity


    concentration_score =

        min(

            machine.product.concentration /
            0.30,

            1.0

        )


    score =

        100.0 *

        (

            0.35 *
            viscosity_score +

            0.25 *
            particle_score +

            0.25 *
            homogeneity_score +

            0.15 *
            concentration_score

        )


    clamp(

        score,

        0.0,

        100.0

    )

end


# ============================================================
# STATUS DISPLAY
# ============================================================

function display_status!(

    machine::PasteMachine

)

    println(

        @sprintf(

            "%-20s | TEMP %6.1f°C | MASS %7.1f g | VISC %5.1f%% | SOLIDS %5.1f%% | PARTICLE %5.2f mm | HOMOG %5.1f%%",

            string(machine.state),

            machine.product.temperature_c,

            machine.product.mass_g,

            machine.product.viscosity * 100,

            machine.product.concentration * 100,

            machine.product.particle_size_mm,

            machine.product.homogeneity * 100

        )

    )

end


# ============================================================
# BATCH REPORT
# ============================================================

function batch_report(

    machine::PasteMachine

)

    return (

        batch_id =
            machine.batch === nothing ?

            "NONE" :

            machine.batch.batch_id,

        recipe =
            machine.recipe.name,

        starting_mass_g =
            machine.batch === nothing ?

            0.0 :

            machine.batch.initial_mass_g,

        final_mass_g =
            machine.product.mass_g,

        water_remaining_g =
            machine.product.water_mass_g,

        solids_g =
            machine.product.solids_mass_g,

        concentration =
            machine.product.concentration,

        viscosity =
            machine.product.viscosity,

        particle_size_mm =
            machine.product.particle_size_mm,

        homogeneity =
            machine.product.homogeneity,

        temperature_c =
            machine.product.temperature_c,

        estimated_pH =
            machine.ph_sensor.pH,

        quality_score =
            quality_score(machine),

        processing_time_min =
            machine.elapsed / 60.0,

        telemetry_points =
            length(
                machine.telemetry.points
            )

    )

end


